<?xml version="1.0" encoding="utf-8"?>
<!-- v10.5 A1: the list scrolls (ListView, AttuneWidgets.ListRows); a tap ticks or unticks; ‹ › switches list; + Add opens the small box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w5_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/w5_bg_s1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w5_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w5_side" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" android:paddingStart="6dp" />
        <TextView android:id="@+id/w5_prev" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="‹" android:textSize="19sp" />
        <TextView android:id="@+id/w5_next" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="›" android:textSize="19sp" />
    </LinearLayout>
    <ListView android:id="@+id/w5_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:paddingTop="2dp" />
    <TextView android:id="@+id/w5_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textSize="12.5sp" android:gravity="center" />
    <LinearLayout android:id="@+id/w5_btns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" />
</LinearLayout>
