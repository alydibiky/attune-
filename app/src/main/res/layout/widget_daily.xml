<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: today's lesson and today's headline. Tapping a row opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/w_lesson"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_lesson_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_lesson"
            android:textColor="#5EEAD4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_lesson"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1E293B" />

    <LinearLayout
        android:id="@+id/w_news"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_news_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_news"
            android:textColor="#FCD34D"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_news"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
