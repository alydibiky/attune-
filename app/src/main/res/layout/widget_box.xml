<?xml version="1.0" encoding="utf-8"?>
<!-- v8.7 (persona 4, idea 11): the Attune box on the home screen — tap to type ("lunch 150"), the mic to say it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/wb_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_box_hint"
        android:textColor="#CBD5E1"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/wb_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🎙"
        android:textSize="20sp"
        android:contentDescription="@string/widget_box_mic" />
</LinearLayout>
