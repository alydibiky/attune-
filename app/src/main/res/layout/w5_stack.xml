<?xml version="1.0" encoding="utf-8"?>
<!-- v10.5 W7 the smart stack: pages chosen by the page's code (widgets2.js stackData); swipe them (StackView). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w5_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <StackView android:id="@+id/w5_stack" android:layout_width="match_parent" android:layout_height="match_parent" android:loopViews="true" />
    <TextView android:id="@+id/w5_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp"
        android:textSize="13sp" android:background="@drawable/w5_bg_s1" />
</FrameLayout>
