<?xml version="1.0" encoding="utf-8"?>
<!-- v10.5 one card for every interactive widget (AttuneWidgets.kt draws it from the page's data; rows and buttons are added per widget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w5_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/w5_bg_s1">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w5_icon" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" />
        <TextView android:id="@+id/w5_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="6dp"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w5_side" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textStyle="bold" android:maxLines="1" android:paddingStart="6dp" />
        <TextView android:id="@+id/w5_prev" android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="‹" android:textSize="18sp" android:visibility="gone" />
        <TextView android:id="@+id/w5_next" android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="›" android:textSize="18sp" android:visibility="gone" />
        <TextView android:id="@+id/w5_eye" android:layout_width="32dp" android:layout_height="30dp" android:gravity="center" android:text="👁" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/w5_biglabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:paddingTop="4dp" android:visibility="gone" />
    <TextView android:id="@+id/w5_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/w5_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12.5sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="2dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/w5_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" />
    <TextView android:id="@+id/w5_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12.5sp" android:paddingTop="6dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/w5_btns" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp" android:gravity="center_vertical" />
</LinearLayout>
