<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- If the fast engine's library asks for a newer Android than 9, the app
         still installs on older phones: there the fast engine simply fails to
         start (caught) and the llama.cpp engine is used. -->
    <uses-sdk tools:overrideLibrary="com.google.ai.edge.litertlm" />

    <!-- Needed for the optional web lookup, the map tiles and downloading a
         model. The assistant itself never uses it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v6.37 Wi-Fi sync between your own devices: Android 17 asks the person first (targetSdk 37) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Android 9 only: the Video Downloader saves to Movies/Attune (Android 10+ needs no permission) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice input (asked for the first time the microphone button is used). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v6.12: Maps → "my location" (asked only when tapped) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Reminders: show the notification (Android 13+ asks once), ring on the
         minute (Android 12+: "Alarms & reminders", allowed in Settings), and
         come back after the phone restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Hand an alarm or timer to the phone's Clock app, filled in. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Keeps the model at full speed while an answer is being written, even
         if the person switches apps (GenService; stops when the answer ends). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Voice phase 3: «يا أتيون» — the mic in a foreground service with its notification, only while the person has it on -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- v8.3 Library: reading a big import of books keeps going with Attune in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- optional: "open by itself over other apps" when the wake word is heard (otherwise a tap-to-talk notification) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v6.3 Fit & Food: READ steps, calories burned, distance, heart rate and workouts from Health
         Connect (the watch apps write them there). Nothing is written. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- v6.41 (F4): Cycle reads the watch's night temperature (asked only from Cycle) -->
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <!-- v8.7: the watch's vitals (Health → From your watch), read only -->
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Lets the app find the phone's speech recogniser (Android 11+). -->
    <queries>
        <!-- v7.9: "Take a photo" opens the phone's camera app -->
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- v6.4: is Huawei Health / Health Sync on the phone (for the Huawei watch setup) -->
        <package android:name="com.huawei.health" />
        <package android:name="nl.appyhapps.healthsync" />
        <!-- v6.43: watch apps for Fit's "Automatic tracking" row (installed or not) -->
        <package android:name="com.sec.android.app.shealth" /><package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.fitbit.FitbitMobile" /><package android:name="fi.polar.polarflow" /><package android:name="com.xiaomi.wearable" />
        <package android:name="com.mi.health" /><package android:name="com.huami.watch.hmwatchmanager" /><package android:name="com.google.android.apps.fitness" />
        <package android:name="com.huawei.hwid" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- v8.4: Android's voice-typing popup, the last way to listen -->
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- To open WhatsApp (or WhatsApp Business) directly for a message. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- v6.27 "Do it for me": is the person's booking / delivery / ride / shop app installed (open it, else the website) -->
        <package android:name="com.talabat" /><package android:name="com.ubercab" /><package android:name="com.ubercab.eats" />
        <package android:name="com.careem.acma" /><package android:name="com.dd.doordash" /><package android:name="com.deliveroo.orderapp" />
        <package android:name="in.swiggy.android" /><package android:name="com.application.zomato" /><package android:name="com.glovo" />
        <package android:name="com.grabtaxi.passenger" /><package android:name="com.gojek.app" /><package android:name="ee.mtakso.client" />
        <package android:name="me.lyft.android" /><package android:name="sinet.startup.inDriver" /><package android:name="com.olacabs.customer" />
        <package android:name="com.booking" /><package android:name="com.airbnb.android" /><package android:name="net.skyscanner.android.main" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <!-- v8.0 Agents (Ali: "make sure it can open any app I ask it to — Uber, Booking, Amazon, Talabat…"): every app that has an
             icon on the home screen can be found by its name and opened -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- v6.5 Huawei Health Kit: Attune's App ID (empty until the AppGallery Connect app exists) -->
        <meta-data android:name="com.huawei.hms.client.appid" android:value="appid=${hmsAppId}" />
        <!-- v6.43: Google Play services fetches the live barcode scanner's screen when Attune is installed, so the first scan opens at once -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui,subject_segment" />
        <!-- Unencrypted http is allowed ONLY to 127.0.0.1, where the on-device
             model listens. Every other connection must be https. -->

        <!-- v6.27 "Do it for me": a website inside Attune, with "Best offer" / "Fill my details" (never pays) -->
        <activity
            android:name=".AgentBrowser"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a payment message, a photo or any text straight into
                 the app from WhatsApp, the gallery, anywhere. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- v8.7: WhatsApp "Export chat → With media" may send the chat and its photos as several files — the groups library -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- v5.35: WhatsApp "Export chat" with media sends a .zip — read by Chat X-Ray -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Select text in ANY app → "Attune" in the menu that appears.
                 The Android version of a system-wide "summarise this" hotkey. -->
            <!-- Health Connect shows why Attune reads health data (required to be granted access). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The phone's own GPU driver (Adreno), for Engine → Speed → GPU.
             Optional: phones without it install and run on the CPU. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- v6.35: the Snapdragon NPU's driver (FastRPC to the Hexagon DSP), for Engine → Speed → NPU. Android 12+ hides a
             phone's vendor libraries from apps unless they are declared here. Optional: other phones install as before. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <!-- Android 14+: Health Connect's "why this app reads your data" link opens Attune. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- v6.37 (H5): the "Attune Instant" quick-settings tile -->
        <service android:name=".InstantTile" android:label="@string/tile_instant" android:icon="@drawable/ic_tile_instant" android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".WakeService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".BookIngestService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".GenService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device AI model writing an answer the user asked for" />
        </service>

        <!-- v6.27: the payment-notification reader (PayListener) is declared in src/full/AndroidManifest.xml ("full" build:
             the main APK and the Play Store bundle). Play Protect's fraud protection blocks a notification reader installed
             from a browser / file manager / chat, so the "lite" build leaves it out for phones that can't install the full one. -->

        <!-- v6.32: the Attune keyboard (AttuneKeyboard.kt) — the user turns it on in the system's keyboard settings. -->
        <service android:name=".AttuneKeyboard" android:label="@string/kb_name" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- Rings a reminder at its time, even with the app closed. -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".ScoutNightReceiver" android:exported="false" />
        <!-- v8.0 Agents: the price watches, checked about every 12 hours even with Attune closed -->
        <receiver android:name=".AgentWatchReceiver" android:exported="false" />
        <!-- Puts reminders back after a restart or an update (Android forgets alarms). -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Home-screen widget: today's lesson and today's headline. -->
        <receiver android:name=".DailyWidget" android:exported="true" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily_info" />
        </receiver>
        <!-- v6.14: Fit & Food widget: calories left today, eaten / goal, water. -->
        <receiver android:name=".FitWidget" android:exported="true" android:label="@string/widget_fit_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_fit_info" />
        </receiver>
        <!-- v8.7: the Attune box on the home screen (BoxWidget.kt): tap to type, the mic to speak. -->
        <receiver android:name=".BoxWidget" android:exported="true" android:label="@string/widget_box_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_box_info" />
        </receiver>
        <!-- Sharing a Studio picture with another app (read-only, one picture at a time). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
