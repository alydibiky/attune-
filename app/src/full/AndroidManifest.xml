<?xml version="1.0" encoding="utf-8"?>
<!-- The "full" build (the main APK and the Play Store bundle): the payment-notification reader. Installed from Google Play
     (or over USB / with Play Protect's scan paused) it is allowed; the "lite" build leaves it out — see src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- v8.7 (Ali: "it reads SMS, but not one-time codes"): the old bank SMS, read once when the person asks (SmsInbox.kt).
         Only this build — the Play build can't declare it (Google allows READ_SMS only for the default SMS app). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <application>
        <!-- v6.27 "Money tracks itself": reads payment notifications on the phone, only after the person turns on
             Notification access for Attune in Settings. SMS notifications too (never one-time codes). Nothing leaves the phone (PayListener.kt). -->
        <service android:name=".PayListener" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
