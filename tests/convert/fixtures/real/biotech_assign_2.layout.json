0,540,0]]]]}],"w":612,"h":792,"imgs":[],"rects":[[305.80,154.67,0.40,81,10921638,-1],[71.68,174.97,468.65,0.40,10921638,-1],[71.68,194.97,468.65,0.40,10921638,-1],[71.68,214.97,468.65,0.40,10921638,-1],[71.98,154.67,0.40,81,10921638,-1],[539.63,154.67,0.40,81,10921638,-1],[71.68,154.97,468.65,0.40,10921638,-1],[71.68,234.97,468.65,0.40,10921638,-1]]},{"n":2,"text":"Q4. Specific substrate-consumption rate \u000aDuring exponential growth: \u000aμ = 0.30 h−1 \u000a\u000aand \u000a\u000aYX/S = 0.60 gX /gS \u000a\u000aAssuming substrate consumption is associated predominantly with biomass formation: \u000a\u000aa. Estimate the specific substrate-consumption rate qS. \u000ab. Explain the difference between qS and the overall substrate-consumption rate of the reactor. \u000a\u000aQ5. Product formation \u000aTwo microbial products show the following behavior: \u000a\u000aProduct A: production rate increases strongly during exponential growth and falls when growth \u000astops. \u000a\u000aProduct B: little product accumulates during exponential growth, but substantial production \u000aoccurs after biomass growth has slowed. \u000a\u000aa. Which product behaves predominantly as a growth-associated product? \u000ab. Which behaves predominantly as a non-growth-associated product? \u000ac. Why should these categories be regarded as useful approximations rather than absolute \u000abiological classes? \u000a\u000aQ6. Integrated interpretation \u000aA batch fermentation shows the following sequence: \u000a\u000aSubstrate decreases → biomass increases → growth rate eventually decreases → product \u000acontinues accumulating after biomass reaches its maximum. \u000a\u000aA student concludes: \u000a\u000a“The cells stop metabolizing once biomass stops increasing.” \u000a\u000aEvaluate this conclusion and propose a more accurate interpretation of the observed profiles. \u000a\u000a2","scan":false,"lines":[{"y":84.51,"x":72,"e":302.98,"s":13.50,"b":true,"i":false,"r":false,"f":"AAAAAB+T