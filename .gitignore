# Build output and local state — never committed.
.gradle/
/build/
app/build/
# web-src/build/ is SOURCE (page shell, icons, shims) and must be committed.
!web-src/build/
# The model engine source is fetched by app/src/main/cpp/fetch-llama.sh, not committed.
app/src/main/cpp/llama.cpp/
local.properties
*.jks
*.keystore
# ...except the fixed TEST key, which must be shared so updates install over each other.
!app/attune-test.keystore
*.b64
.idea/
app/src/main/cpp/opencl/
# Python for the Code sandbox: fetched by web-src/fetch-pyodide.sh (CI does it), not committed.
app/src/main/assets/www/py/
web-src/.pyodide-cache/
# Studio's picture engine: built by app/src/main/cpp/build-image-engine.sh (CI does it).
app/src/main/jniLibs/
app/src/main/cpp/stable-diffusion.cpp/
tests/image_run/sd
tests/image_run/work/
tests/image_run/*.pth
tests/image_run/*.jar
