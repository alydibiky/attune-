{
  "name": "attune-desktop",
  "productName": "Attune",
  "version": "6.31.0",
  "description": "Attune for Windows, macOS and Linux: the same app, private models on this computer.",
  "main": "main.js",
  "author": "Aly Aldibiki",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/alydibiky/attune-",
  "scripts": {
    "start": "electron .",
    "test:unit": "node test/unit.js",
    "smoke": "node test/smoke.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.aldibiki.attune.desktop",
    "productName": "Attune",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pdfworker.html",
      "lib/**",
      "test/smoke-run.js"
    ],
    "extraResources": [
      {
        "from": "../app/src/main/assets/www",
        "to": "www",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "maintainer": "Attune <noreply@example.invalid>"
    }
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  }
}
